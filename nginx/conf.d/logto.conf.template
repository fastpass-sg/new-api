# Logto auth endpoint — the domain applications and browsers talk OIDC to.
#
# Rendered by scripts/deploy.sh and scripts/upgrade.sh, substituting
# LOGTO_DOMAIN. Rendered only when LOGTO_ENABLED=true, and deleted again when it
# is not. The rendered logto.conf is gitignored.
#
# Deliberately no `upstream` block. nginx resolves upstream hostnames while
# parsing the config and refuses to start — or to reload — when one is unknown,
# so a declared `server logto:3001` makes the whole site, not just Logto,
# dependent on the Logto container existing. That bites during the very first
# deploy, where certificates have to be issued and nginx reloaded before Logto
# has ever started.
#
# Passing the address through a variable defers resolution to request time via
# Docker's embedded DNS. Logto being absent, restarting or broken then costs a
# 502 on its own domain and nothing else.

server {
    listen 443 ssl;
    http2 on;
    server_name ${LOGTO_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${LOGTO_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${LOGTO_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Sign-in pages and token exchanges; no large bodies, no long polls.
    client_max_body_size 10m;
    proxy_connect_timeout 15s;
    proxy_read_timeout    60s;
    proxy_send_timeout    60s;

    proxy_http_version 1.1;

    # Logto builds absolute URLs (issuer, redirects) from these. They must match
    # ENDPOINT in the container environment exactly, or OIDC discovery and the
    # authorization redirects will point at the wrong origin.
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host  $host;

    # See the map{} block in _shared.conf.
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # Docker's embedded DNS. ipv6=off because the compose network is IPv4 and
    # the AAAA lookup only adds latency to every resolution.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $logto_core http://logto:3001;

    location / {
        # $request_uri is explicit rather than implied: once proxy_pass contains
        # a variable, nginx no longer derives the upstream URI from the location.
        proxy_pass $logto_core$request_uri;
    }
}
