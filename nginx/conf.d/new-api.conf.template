# Rendered by scripts/deploy.sh and scripts/upgrade.sh via:
#   envsubst '${DOMAIN_NAME}' < new-api.conf.template > new-api.conf
# The rendered new-api.conf is gitignored.

# Maps client Connection/Upgrade headers to what we should send upstream:
#   WebSocket request (Upgrade present) → Connection: upgrade
#   Regular HTTP                        → Connection: "" (let nginx pool it)
# Required for `keepalive` in the upstream block to actually work.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      "";
}

# Upstream keepalive: keep up to 100 idle connections to new-api per worker.
# Cuts TCP handshake overhead and prevents TIME_WAIT accumulation under load.
upstream new_api_backend {
    server new-api:3000;
    keepalive 100;
    keepalive_requests 10000;
    keepalive_timeout  60s;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN_NAME};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Uploads: images / PDFs / long prompts.
    client_max_body_size 128m;

    # Some non-stream LLM calls take 5–10+ minutes to return. HTTP/1.1 has no
    # in-request heartbeat; nginx just waits. We give generous headroom on
    # every timeout in the chain so a real long request isn't killed:
    #   - proxy_read_timeout: gap between reads FROM new-api (this is the one
    #     that actually fires for a long non-streaming call — bump it high).
    #   - proxy_send_timeout: gap between writes TO new-api (large uploads).
    #   - client_body_timeout / send_timeout: gaps on the client side.
    proxy_http_version 1.1;
    proxy_buffering    off;
    proxy_cache        off;
    proxy_read_timeout    1200s;
    proxy_send_timeout    1200s;
    proxy_connect_timeout   30s;
    client_body_timeout    600s;
    send_timeout           600s;
    keepalive_timeout       75s;

    # Send small packets immediately (streaming SSE feels responsive).
    tcp_nodelay on;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    # See the map{} block at the top of this file.
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    location / {
        proxy_pass http://new_api_backend;
    }
}
