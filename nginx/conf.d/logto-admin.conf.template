# Logto admin console — operators only.
#
# Rendered by scripts/deploy.sh and scripts/upgrade.sh, substituting
# LOGTO_ADMIN_DOMAIN and LOGTO_ADMIN_ALLOW_BLOCK. Rendered only when
# LOGTO_ENABLED=true, and deleted again when it is not. The rendered
# logto-admin.conf is gitignored.
#
# Placeholder names are never written in full here: envsubst would substitute
# them inside this comment too, and the allowlist is multi-line, so the tail of
# it would land outside any server block and stop nginx from starting.
#
# See logto.conf.template for why the upstream is declared per-file rather than
# in _shared.conf.

upstream logto_admin {
    server logto:3002;
    keepalive 16;
    keepalive_requests 1000;
    keepalive_timeout  60s;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${LOGTO_ADMIN_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${LOGTO_ADMIN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${LOGTO_ADMIN_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Rendered from LOGTO_ADMIN_ALLOW in .env; empty when no IP restriction is
    # configured. This is a second gate in front of Logto's own admin login,
    # not a replacement for it.
${LOGTO_ADMIN_ALLOW_BLOCK}

    client_max_body_size 10m;
    proxy_connect_timeout 15s;
    proxy_read_timeout    60s;
    proxy_send_timeout    60s;

    proxy_http_version 1.1;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host  $host;

    # See the map{} block in _shared.conf.
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    location / {
        proxy_pass http://logto_admin;
    }
}
