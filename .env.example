# 端口号
# PORT=3000
# 前端基础URL
# FRONTEND_BASE_URL=https://your-frontend-url.com


# 调试相关配置
# 启用pprof
# ENABLE_PPROF=true
# 启用调试模式
# DEBUG=true
# Pyroscope 配置
# PYROSCOPE_URL=http://localhost:4040
# PYROSCOPE_APP_NAME=new-api
# PYROSCOPE_BASIC_AUTH_USER=your-user
# PYROSCOPE_BASIC_AUTH_PASSWORD=your-password
# PYROSCOPE_MUTEX_RATE=5
# PYROSCOPE_BLOCK_RATE=5
# HOSTNAME=your-hostname

# 数据库相关配置
# 启用错误日志记录
# ERROR_LOG_ENABLED=true
# 数据库连接字符串
# SQL_DSN=user:password@tcp(127.0.0.1:3306)/dbname?parseTime=true
# 日志数据库连接字符串
# LOG_SQL_DSN=user:password@tcp(127.0.0.1:3306)/logdb?parseTime=true
# SQLite数据库路径
# SQLITE_PATH=/path/to/sqlite.db
# 数据库最大空闲连接数
# SQL_MAX_IDLE_CONNS=100
# 数据库最大打开连接数
# SQL_MAX_OPEN_CONNS=1000
# 数据库连接最大生命周期（秒）
# SQL_MAX_LIFETIME=60
# 慢查询日志阈值（毫秒），0 表示关闭慢查询日志，超出 0-3600000 范围回退默认值 200
# SQL_SLOW_THRESHOLD_MS=200


# 缓存相关配置
# Redis连接字符串
# REDIS_CONN_STRING=redis://user:password@localhost:6379/0
# 同步频率（单位：秒）
# SYNC_FREQUENCY=60
# 内存缓存启用
# MEMORY_CACHE_ENABLED=true
# 渠道更新频率（单位：秒）
# CHANNEL_UPDATE_FREQUENCY=30
# 批量更新启用
# BATCH_UPDATE_ENABLED=true
# 批量更新间隔（单位：秒）
# BATCH_UPDATE_INTERVAL=5

# 任务和功能配置
# 更新任务启用
# UPDATE_TASK=true

# 对话超时设置
# 所有请求超时时间，单位秒，默认为0，表示不限制
# RELAY_TIMEOUT=0
# Relay HTTP 客户端空闲连接超时时间，单位秒，默认跟随 Go 标准库，设置为0表示不限制
# RELAY_IDLE_CONN_TIMEOUT=90
# 流模式无响应超时时间，单位秒，如果出现空补全可以尝试改为更大值
# STREAMING_TIMEOUT=300

# TLS / HTTP 跳过验证设置
# TLS_INSECURE_SKIP_VERIFY=false

# Gin 可信反向代理（逗号分隔的 IP/CIDR）
# 未配置/留空：默认信任 127.0.0.0/8、::1、RFC1918 私网和 fc00::/7，并打印启动告警。
# none：严格模式，不信任任何代理且必须单独使用；显式列表完全替代默认值，应填写代理自身地址。
# TRUSTED_PROXIES=none
# TRUSTED_PROXIES=127.0.0.1,172.20.0.0/16

# Gemini 识别图片 最大图片数量
# GEMINI_VISION_MAX_IMAGE_NUM=16

# 会话密钥
# SESSION_SECRET=random_string
# false/未配置：本地 HTTP 模式，关闭 refresh/logout OriginGuard，且不得设置 TRUSTED_URL；兼容本地开发代理。
# true：启用 Secure Refresh Cookie 和严格 OriginGuard，必须同时列出全部可信 HTTPS Origin。
# SESSION_COOKIE_TRUSTED_URL 多项用英文逗号分隔；不支持通配符、路径或域名后缀匹配。
# 这些设置不修改 relay CORS。
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_TRUSTED_URL=https://example.com,https://admin.example.com
# 每用户最多保留的活跃登录 Session
# USER_SESSION_ACTIVE_LIMIT=50
# 单用户在签发窗口内允许创建的 Session 总数（包含已撤销）
# USER_SESSION_ISSUANCE_LIMIT=100
# Session 签发计数窗口（秒）；不得大于 revoked 保留期，超出时会自动钳制
# USER_SESSION_ISSUANCE_WINDOW_SECONDS=86400
# revoked Session 审计保留天数
# USER_SESSION_REVOKED_RETENTION_DAYS=7
# 最近一小时全局 Session 签发量超过此值时记录告警，不会拒绝登录
# USER_SESSION_HOURLY_ALERT_THRESHOLD=5000

# 其他配置
# 生成默认token
# GENERATE_DEFAULT_TOKEN=false
# Cohere 安全设置
# COHERE_SAFETY_SETTING=NONE
# 是否统计图片token
# GET_MEDIA_TOKEN=true
# 是否在非流（stream=false）情况下统计图片token
# GET_MEDIA_TOKEN_NOT_STREAM=false
# 设置 Dify 渠道是否输出工作流和节点信息到客户端
# DIFY_DEBUG=true

# LinuxDo相关配置
LINUX_DO_TOKEN_ENDPOINT=https://connect.linux.do/oauth2/token
LINUX_DO_USER_ENDPOINT=https://connect.linux.do/api/user

# 节点类型
# 如果是主节点则为master
# NODE_TYPE=master

# 可信任重定向域名列表（逗号分隔，支持子域名匹配）
# 用于验证支付成功/取消回调URL的域名安全性
# 示例: example.com,myapp.io 将允许 example.com, sub.example.com, myapp.io 等
# TRUSTED_REDIRECT_DOMAINS=example.com,myapp.io


# ============================================================
# Production deployment (docker-compose.prod.yml)
# ============================================================
# Copy this file to .env (or run ./scripts/gen-env.sh) and fill the values below.
# .env is gitignored. Never commit real secrets.

# Public domain that nginx serves HTTPS on. Must already resolve to this host.
DOMAIN_NAME=example.com
# Contact email for Let's Encrypt registration / expiry notices.
CERTBOT_EMAIL=admin@example.com

# PostgreSQL credentials used by docker-compose.prod.yml.
POSTGRES_USER=newapi
POSTGRES_DB=new_api
# Generate with: openssl rand -hex 32 (gen-env.sh does this automatically).
POSTGRES_PASSWORD=

# Redis password. Generate with: openssl rand -hex 32.
REDIS_PASSWORD=

# Session/cookie encryption key. Required for multi-node; must be a strong random
# value. Never use the literal string "random_string" — the app refuses to start.
SESSION_SECRET=
# Optional. Leave empty to fall back to SESSION_SECRET.
CRYPTO_SECRET=

# Timezone passed into all containers.
TZ=Asia/Shanghai
# Node identifier used in audit logs (set differently per instance for HA).
NODE_NAME=new-api-node-1

# Image to run. Always pin an explicit tag: `latest` turns every upgrade.sh run
# into an unreviewed upgrade. Bump this deliberately after reading the release
# notes, then run ./scripts/upgrade.sh.
#
# This fork carries patches upstream does not have (currently RP-initiated
# logout for OIDC providers), so running upstream's image silently drops them.
# .github/workflows/fork-image.yml publishes the fork's build on every push to
# main and on every tag:
#   ghcr.io/fastpass-sg/new-api:main-<sha>   built from a main commit
#   ghcr.io/fastpass-sg/new-api:<tag>        built from a git tag
#
# Upstream's own image stays available if you want none of the fork's changes:
#   calciumion/new-api:v1.0.0-rc.24
NEW_API_IMAGE=ghcr.io/fastpass-sg/new-api:main

# Reverse-proxy trust for Gin's ClientIP(). Leaving this empty trusts loopback
# plus the RFC1918 ranges (which covers the compose bridge) and prints a startup
# warning. Naming the bridge explicitly silences it. Find the subnet with:
#   docker network inspect new-api_new-api-network -f '{{(index .IPAM.Config 0).Subnet}}'
TRUSTED_PROXIES=

# Secure session cookies. `true` enables the Secure refresh cookie and strict
# OriginGuard, and requires every trusted HTTPS origin to be listed.
# Recommended once the site is fully behind HTTPS. deploy.sh derives
# SESSION_COOKIE_TRUSTED_URL from DOMAIN_NAME when it is left empty, so the two
# settings can never drift apart. Only new-api's own origin belongs here —
# Logto is a separate application, not a new-api origin.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_TRUSTED_URL=

# Host directory for all runtime state (postgres, redis, app data, nginx certs,
# nginx webroot, nginx logs). Kept outside the deploy directory so sync.sh and
# git operations never touch persistent data. deploy.sh creates the subtree.
DATA_ROOT=/data/newapi_data

# TLS certificate management:
#   byo         (default) — you provide a certificate and key. deploy.sh will
#                refuse to start if they aren't present. The certbot container
#                stays disabled. Drop your files at:
#                  ${DATA_ROOT}/nginx/certs/live/${DOMAIN_NAME}/fullchain.pem
#                  ${DATA_ROOT}/nginx/certs/live/${DOMAIN_NAME}/privkey.pem
#   letsencrypt — enable the Let's Encrypt + certbot profile. deploy.sh will
#                request a cert via http-01 and certbot will auto-renew.
# This governs the main domain only. The Logto domains have their own knob
# (LOGTO_CERT_MODE) so the main site can keep a BYO certificate while the new
# Logto domains use Let's Encrypt.
CERT_MODE=byo


# ============================================================
# Logto — single sign-on identity provider
# ============================================================
# Logto runs behind the same nginx on two dedicated domains: one for the auth
# endpoint that applications talk to, one for the admin console. new-api joins
# as an OIDC relying party; other sites can join later the same way.
#
# Leave LOGTO_ENABLED=false to deploy new-api alone. When false, the Logto
# container is not started and its nginx server blocks are not rendered, so
# nothing references a host that does not exist.
LOGTO_ENABLED=false

# Pin the version. Logto ships schema migrations, so read the release notes and
# take a backup (./scripts/backup.sh) before bumping this.
LOGTO_IMAGE=svhd/logto:1.42.0

# Both must already resolve to this host before enabling Let's Encrypt.
#   LOGTO_DOMAIN        — auth endpoint; applications and browsers hit this.
#   LOGTO_ADMIN_DOMAIN  — admin console; only operators need it.
LOGTO_DOMAIN=auth.example.com
LOGTO_ADMIN_DOMAIN=auth-admin.example.com

# Optional extra gate in front of the admin console, on top of Logto's own
# login. Space-separated IPs or CIDRs; empty means no IP restriction.
# Must stay quoted: the deploy scripts source this file with `.`, so an
# unquoted value containing spaces would be split into shell words.
#   LOGTO_ADMIN_ALLOW="203.0.113.4 198.51.100.0/24"
LOGTO_ADMIN_ALLOW=""

# Logto gets its own database and role inside the existing Postgres instance.
# deploy.sh creates both if missing. The role must own the database: since
# PostgreSQL 15 the public schema no longer grants CREATE to PUBLIC, and Logto's
# schema seeding fails without ownership.
LOGTO_DB_NAME=logto
LOGTO_DB_USER=logto
# Generate with: openssl rand -hex 32 (gen-env.sh does this automatically).
LOGTO_DB_PASSWORD=

# TLS for the two Logto domains, independent of CERT_MODE above.
#   letsencrypt (default) — deploy.sh requests one certificate per domain and
#                certbot auto-renews them. Requires both domains to resolve here.
#   byo         — you place the files yourself at
#                  ${DATA_ROOT}/nginx/certs/live/<domain>/fullchain.pem
#                  ${DATA_ROOT}/nginx/certs/live/<domain>/privkey.pem
LOGTO_CERT_MODE=letsencrypt


# ============================================================
# Database backups
# ============================================================
# scripts/backup.sh dumps the new-api database and, when present, the Logto
# database. Losing the Logto database locks out every user who bound their
# account to it, so this is not optional once SSO is live.

# Crontab schedule for automatic backups. deploy.sh installs (and keeps in sync)
# a single tagged crontab entry for the invoking user. Leave empty to manage
# scheduling yourself; deploy.sh then never touches the crontab.
# Must stay quoted: the deploy scripts source this file with `.`, so the spaces
# and asterisks would otherwise be split and glob-expanded.
BACKUP_CRON="15 3 * * *"

# Dumps older than this are pruned after each successful run.
BACKUP_RETENTION_DAYS=14
